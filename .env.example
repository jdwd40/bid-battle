# Server port (default 3001)
PORT=3001
# Milliseconds of presentation delay before an AI seat acts (default 900). Set 0 for tests.
BOT_DELAY_MS=900
# Optional timer overrides (milliseconds). Defaults: 20000 / 20000 / 10000 / 30000
# QUOTE_PREP_MS=20000
# TURN_MS=20000
# COUNTER_MS=10000
# REVIEW_MS=30000
# Abuse limits. Defaults: 5 rooms per IP per 600000 ms, 100 open rooms, 20 messages per second per connection.
# ROOMS_PER_IP=5
# ROOM_WINDOW_MS=600000
# MAX_OPEN_ROOMS=100
# MESSAGES_PER_SECOND=20
# Trusted header carrying the client IP. Set to Fly-Client-IP in production; unset uses the socket's remote address.
# CLIENT_IP_HEADER=Fly-Client-IP
# Comma-separated origins allowed to connect, e.g. https://bid-battle.fly.dev (set in production).
# Unset: only local dev origins (http://localhost:5173 and the server's own port, on localhost/127.0.0.1).
# ALLOWED_ORIGINS=https://bid-battle.fly.dev
