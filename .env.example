# Server port (default 3001)
PORT=3001
# Milliseconds of presentation delay before a bot acts (default 900). Set 0 for tests.
BOT_DELAY_MS=900
# Optional timer overrides (milliseconds). Defaults: 20000 / 20000 / 10000 / 30000
# QUOTE_PREP_MS=20000
# TURN_MS=20000
# COUNTER_MS=10000
# REVIEW_MS=30000
# Abuse limits. Defaults: 5 rooms per IP per 600000 ms, 100 open rooms, 20 messages per second per connection.
# ROOMS_PER_IP=5
# (The Playwright e2e servers set ROOMS_PER_IP=1000 because the suite creates many rooms from one IP; keep 5 in production.)
# ROOM_WINDOW_MS=600000
# MAX_OPEN_ROOMS=100
# MESSAGES_PER_SECOND=20
# Trusted header carrying the client IP. Set to X-Real-IP in production (nginx sets it); unset uses the socket's remote address.
# CLIENT_IP_HEADER=X-Real-IP
# Comma-separated origins allowed to connect, e.g. https://bidbattle.jdwd40.com (set in production).
# Unset: only local dev origins (http://localhost:5173 and the server's own port, on localhost/127.0.0.1).
# ALLOWED_ORIGINS=https://bidbattle.jdwd40.com
