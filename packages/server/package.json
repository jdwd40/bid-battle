{
  "name": "@bid-battle/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --packages=external --alias:@bid-battle/engine=../engine/src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@bid-battle/engine": "*",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.0",
    "esbuild": "^0.25.0"
  }
}
